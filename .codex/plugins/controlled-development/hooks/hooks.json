{
  "description": "Controlled Development lifecycle enforcement hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/run-hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\run-hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Loading controlled change enforcement"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/run-hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\run-hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking controlled change permission"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/run-hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\run-hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Auditing controlled change side effects"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/hooks/run-hook.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%\\hooks\\run-hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking controlled change completion"
          }
        ]
      }
    ]
  }
}
